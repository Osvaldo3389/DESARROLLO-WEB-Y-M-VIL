# Configuración LOCAL de Fukusuke (sin secretos de la aplicación: esos se generan en ./secrets).
# `npm run setup` copia este archivo a .env la primera vez. El .env NO se sube a git.

# --- MySQL / MariaDB de tu PC (XAMPP, MySQL Installer, etc.) ---
DB_HOST=127.0.0.1
DB_PORT=3306
# Cuenta administradora: solo la usa `npm run setup` para crear las bases y los usuarios de cada servicio.
# En XAMPP el usuario root viene SIN contraseña (dejar vacío). Si instalaste MySQL con contraseña, escríbela aquí.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# --- Puertos ---
# Página + API (HTTPS). Cámbialo si el 8443 está ocupado.
GATEWAY_PORT=8443

# --- Negocio ---
COBERTURA_COMUNAS=Maipú
# Cada cuánto (ms) se reenvían eventos pendientes del outbox
OUTBOX_INTERVAL_MS=5000

# --- Solo para Docker / Vault (no se usan en modo local) ---
SECRET_PROVIDER=file
# VAULT_ADDR=http://vault:8200
