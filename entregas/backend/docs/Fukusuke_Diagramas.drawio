        <mxCell id="seq-22" value="15. 201 {pagoId, redirectUrl} (vía gateway) → redirección a Servipag" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1020" y="675" as="sourcePoint" />
            <mxPoint x="100" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-23" value="16. POST /api/v1/payments/webhooks/servipag&lt;br&gt;(firma HMAC)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1250" y="740" as="sourcePoint" />
            <mxPoint x="330" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-24" value="17. reenvía solo si la firma es válida" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="330" y="780" as="sourcePoint" />
            <mxPoint x="1020" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-25" value="18. verifica firma, monto e idempotencia&lt;br&gt;(transaccionId ya procesado → 200 sin efecto)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1035" y="790" width="270" height="50" />
        </mxCell>
        <mxCell id="seq-26" value="19. PATCH /internal/orders/{id}/estado = PAGADO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1020" y="860" as="sourcePoint" />
            <mxPoint x="560" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-27" value="20. emite boleta (cajero virtual)&lt;br&gt;y la envía por correo (RF8)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1035" y="870" width="210" height="40" />
        </mxCell>
        <mxCell id="seq-28" value="21. 200 OK al proveedor" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint x="1020" y="935" as="sourcePoint" />
            <mxPoint x="330" y="935" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="seq-29" value="&lt;b&gt;alt&lt;/b&gt; [inventory no responde en 2 s] → orders responde 503 y NO crea el pedido.&lt;br&gt;&lt;b&gt;alt&lt;/b&gt; [Servipag rechaza] → Pago = RECHAZADO; Pedido sigue PENDIENTE_PAGO y puede reintentar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="20" y="990" width="760" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
